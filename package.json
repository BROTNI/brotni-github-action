  "scripts": {
    "build": "ncc build src/index.js -o dist --source-map --license dist/licenses.txt",
    "test": "jest --coverage",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BROTNI/brotni-github-action.git"
  },
